{
  "name": "dsh-cookie-sweep",
  "version": "0.1.5",
  "description": "顺手扫掉 DSH 登录留下的 dsh-auth-* cookie（每次启动端口都变，名字跟着变，30 天不清理，攒够 16KB 请求头就会被 431）。退出后自动清一次，也可以手动 status / dry-run / apply。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "cookie-sweep": "bin/helper.mjs"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node test/sweep.test.mjs && node test/sentinel.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cookies",
    "maintenance",
    "431"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/<你的用户名>/dsh-cookie-sweep.git"
  },
  "bugs": {
    "url": "https://github.com/<你的用户名>/dsh-cookie-sweep/issues"
  },
  "homepage": "https://github.com/<你的用户名>/dsh-cookie-sweep#readme"
}

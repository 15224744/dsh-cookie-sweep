{
  "name": "dsh-cookie-sweep",
  "version": "0.2.0",
  "description": "DSH 登录 cookie 清理：宿主退出后清掉历史 dsh-auth-*（默认只删本机域名、每库单独备份、宿主活着绝不动手）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "cookie-sweep": "bin/helper.mjs"
  },
  "files": [
    "lib",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md"
  ],
  "scripts": {
    "test": "node test/sweep.test.mjs && node test/sentinel.test.mjs && node test/safety.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cookies",
    "maintenance"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  }
}
